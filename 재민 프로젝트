import pygame
import math

pygame.init()
WIDTH, HEIGHT = 1500, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("물리 엔진")
clock = pygame.time.Clock()

WHITE = (255, 255, 255)
BLUE = (0, 100, 255)
RED = (255, 0, 255)
BLACK = (0, 0, 0)

gravity = 0.5
launch_angle = 45  
power = 24
ball_pos = [50, 550]
velocity = [0, 0]
launched = False
path = []

def launch():
    rad = math.radians(launch_angle)
    vx = power * math.cos(rad)
    vy = -power * math.sin(rad)
    return [vx, vy] 

running = True
while running:
    screen.fill(WHITE)
    
    # 1. 연속적인 키 입력 처리 (각도 및 힘 조절을 부드럽게 만들기 위함)
    keys = pygame.key.get_pressed()
    if not launched:  # 발사 전 상태에서만 조절 가능
        if keys[pygame.K_UP]:
            launch_angle = min(180, launch_angle + 1.5)   # 최대 90도
        if keys[pygame.K_DOWN]:
            launch_angle = max(0, launch_angle - 1.5)    # 최소 0도
        if keys[pygame.K_RIGHT]:
            power = min(100, power + 1)               # 최대 파워 50
        if keys[pygame.K_LEFT]:
            power = max(5, power - 0.5)                # 최소 파워 5
    
    # 2. 단발성 이벤트 처리 (발사 및 리셋)
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        
        if event.type == pygame.KEYDOWN:
            # 발사 (아직 발사되지 않았을 때만 가능)
            if event.key == pygame.K_SPACE and not launched:
                velocity = launch()
                launched = True
            
            # 리셋 (V 키를 누르면 즉시 모든 상태 초기화)
            if event.key == pygame.K_v:
                ball_pos = [50, 550]
                velocity = [0, 0]
                launched = False
                path = []
    
    # 3. 물리 엔진 및 위치 업데이트
    if launched:
        velocity[1] += gravity
        ball_pos[0] += velocity[0]
        ball_pos[1] += velocity[1]
        path.append((int(ball_pos[0]), int(ball_pos[1])))
        
        # 바닥 충돌 검사
        if ball_pos[1] >= 550:
            ball_pos[1] = 550
            launched = False
            velocity = [0, 0]

    # 4. 그리기 (가이드라인)
    line_len = 100
    line_x = 50 + math.cos(math.radians(launch_angle)) * line_len
    line_y = 550 - math.sin(math.radians(launch_angle)) * line_len
    pygame.draw.line(screen, BLACK, (50, 550), (line_x, line_y), 2)

    # 궤적 그리기
    for p in path:
        pygame.draw.circle(screen, RED, p, 2)

    # 공 그리기
    pygame.draw.circle(screen, BLUE, (int(ball_pos[0]), int(ball_pos[1])), 15)

    # UI 텍스트 출력
    font = pygame.font.SysFont("malgungothic", 24)  # 한글 깨짐 방지용 폰트 설정 (윈도우 기준)
    info_text = f"각도(위/아래): {launch_angle}° | 파워(좌/우): {power:.1f} | [SPACE]: 발사 | [V]: 리셋"
    img = font.render(info_text, True, BLACK)
    screen.blit(img, (20, 20))

    pygame.display.flip()
    clock.tick(60)

pygame.quit()